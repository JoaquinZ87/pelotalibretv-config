{
  "id": "pelotalibre",
  "name": "Pelota Libre",
  "platform": "Pelota Libre",
  "mirrors": [
    "https://pelotalibrehd.su"
  ],
  "homePath": "/es/",
  "agendaPath": "/es/agenda/",
  "sourceUtcOffsetMinutes": -300,
  "targetUtcOffsetMinutes": -180,
  "channelsEnabled": false,
  "strategy": "menu2",
  "agendaRecipe": {
    "format": "html",
    "recognize": "ul#menu",
    "items": "ul#menu > li",
    "allowEmpty": true,
    "timeFormat": "HH:mm:ss",
    "fields": {
      "title": {
        "select": ".info span"
      },
      "time": {
        "select": ".info time",
        "read": "attr",
        "attribute": "datetime"
      },
      "category": {
        "read": "attr",
        "attribute": "data-category"
      }
    },
    "servers": {
      "items": "a[href*='?r=']",
      "fields": {
        "name": {
          "select": "span"
        },
        "url": {
          "read": "attr",
          "attribute": "href",
          "transforms": [
            {
              "op": "query",
              "value": "r"
            },
            {
              "op": "base64"
            },
            {
              "op": "absolute"
            }
          ]
        }
      }
    }
  },
  "resolverRecipe": {
    "format": "html",
    "url": {
      "select": "iframe#plyr, iframe#streamIframe, iframe#embedIframe, .player iframe, #player iframe, #playerContainer iframe",
      "read": "attr",
      "attribute": "src"
    }
  }
}
